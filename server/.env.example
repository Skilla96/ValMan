# ValMan backend v0.5
PORT=8787
DATA_DIR=/data

# Change both before exposing the server on the Internet.
JWT_SECRET=replace-with-a-long-random-secret
VALMAN_SETUP_CODE=replace-with-a-one-time-setup-code

# Optional but required for Skilla Bot online / neural voice / web manual search.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=marin

# Optional: if configured, uploaded manuals can be indexed for file_search.
OPENAI_VECTOR_STORE_ID=
